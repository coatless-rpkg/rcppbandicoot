## RcppBandicoot Makevars.in
##
## This file is processed by configure to generate Makevars
## It includes GPU backend configuration (OpenCL, CUDA) and other settings

## COOT_KERNEL_SOURCE_DIR is a call to rcppbandicoot_kernel_dir() (declared in
## RcppBandicootForward.h), not a string literal, so bandicoot resolves its
## kernel directory at run time -- see that header for why. The single quotes
## protect the parentheses from the shell make runs the compile through.
## RCPPBANDICOOT_KERNEL_DIR_DEFAULT is the configure-time path the function
## falls back to before .onLoad overrides it (correct for a source install).
PKG_CPPFLAGS = -I../inst/include -DCOOT_TARGET_OPENCL_VERSION=@OPENCL_TARGET_VERSION@ -DCOOT_KERNEL_SOURCE_DIR='rcppbandicoot_kernel_dir()' -DRCPPBANDICOOT_KERNEL_DIR_DEFAULT='"@BANDICOOT_KERNELS_DIR@"'

## Compiler flags from configure
PKG_CXXFLAGS = @BANDICOOT_CXXFLAGS@

## Linker flags from configure
PKG_LIBS = @OPENMP_CXXFLAGS@ @BANDICOOT_LIBS@
