#!/bin/sh
##
## RcppBandicoot configure.win
##
## Windows-specific configuration script
## Detects OpenCL and CLBlast from environment variables
##
## Copyright (C) 2023-2025 James Balamuta
## Licensed under GPL-2 or later
##

echo "Configuring RcppBandicoot for Windows..."

## Get R_HOME
: ${R_HOME=$(R RHOME)}
if test -z "${R_HOME}"; then
    echo "ERROR: Could not determine R_HOME"
    exit 1
fi

## Escape a value for use as sed *replacement* text.  sed gives three
## characters special meaning there: a backslash, an & (stands for the whole
## match), and the delimiter, which is | throughout this script.  Without this
## the natural Windows spelling OPENCL_CPPFLAGS=-IC:\OpenCL\include arrives in
## the generated file as -IC:OpenCLinclude, and a value containing & or |
## corrupts the substitution outright, leaving a literal @PLACEHOLDER@ behind.
## esc() is applied at the point of substitution rather than where the value is
## captured, so a composed value such as BANDICOOT_CXXFLAGS -- which folds in
## OPENCL_CPPFLAGS and CLBLAST_CPPFLAGS -- is escaped exactly once.
esc() {
    printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'
}

## Same job, for the R/flags.R substitutions.  Every placeholder in
## R/flags.R.in sits inside an R string literal, so a value that reaches R with
## its backslashes intact -- which is exactly what esc() now guarantees --
## makes the generated file unparseable: -IC:\OpenCL\include becomes the
## unrecognized escape '\O'.  Escape backslash and both quote characters for R
## first, then hand the result to esc() for sed.  src/Makevars.win keeps the
## plain esc(), since make passes those flags straight to the compiler and must
## not see doubled backslashes.
esc_r() {
    esc "$(printf '%s' "$1" | sed -e 's/[\\"'\'']/\\&/g')"
}

## Default values
BANDICOOT_CXXFLAGS=""
BANDICOOT_LIBS=""
OPENMP_CXXFLAGS='$(SHLIB_OPENMP_CXXFLAGS)'
OPENCL_TARGET_VERSION=300

## Kernel source directory (matches configure.ac logic).
## R_LIBRARY_DIR is the final library directory; head(.libPaths(),1) during a
## staged install is the transient 00LOCK-RcppBandicoot/00new staging tree.
if [ -n "${R_LIBRARY_DIR}" ]; then
    BANDICOOT_LIB_DIR="${R_LIBRARY_DIR}"
else
    BANDICOOT_LIB_DIR=$("${R_HOME}/bin/Rscript" -e 'cat(head(.libPaths(),1))')
fi
BANDICOOT_LIB_DIR=$(echo "${BANDICOOT_LIB_DIR}" | sed -e 's|/00LOCK-[^/]*/00new$||')
BANDICOOT_KERNELS_DIR="${BANDICOOT_LIB_DIR}/RcppBandicoot/include/bandicoot_bits/ks/"

## Always disable CUDA on Windows (requires manual setup)
BANDICOOT_CXXFLAGS="${BANDICOOT_CXXFLAGS} -DCOOT_DONT_USE_CUDA"

## OpenCL requires both the headers (OPENCL_CPPFLAGS) and the link flags
## (OPENCL_LIBS). Enabling the backend with only one set would compile but
## fail to link, so gate COOT_USE_OPENCL on having both.
if [ -n "${OPENCL_CPPFLAGS}" ] && [ -n "${OPENCL_LIBS}" ]; then
    echo "  OpenCL headers: found (via OPENCL_CPPFLAGS)"
    echo "  OpenCL library: found (via OPENCL_LIBS): ${OPENCL_LIBS}"
    BANDICOOT_CXXFLAGS="${BANDICOOT_CXXFLAGS} -DCOOT_USE_OPENCL ${OPENCL_CPPFLAGS}"
    ## OpenCL is the only backend on Windows (CUDA is disabled above), so it is
    ## the default backend -- matching configure.ac's CL_BACKEND choice, and
    ## what RcppBandicootCxxFlags() reports to downstream consumers.
    BANDICOOT_CXXFLAGS="${BANDICOOT_CXXFLAGS} -DCOOT_DEFAULT_BACKEND=CL_BACKEND"
    BANDICOOT_LIBS="${BANDICOOT_LIBS} ${OPENCL_LIBS}"
    HAVE_OPENCL=1
else
    echo "  OpenCL: not configured (need both OPENCL_CPPFLAGS and OPENCL_LIBS)"
    [ -z "${OPENCL_CPPFLAGS}" ] && echo "    missing OPENCL_CPPFLAGS"
    [ -z "${OPENCL_LIBS}" ] && echo "    missing OPENCL_LIBS"
    HAVE_OPENCL=0
fi

## CLBlast requires both the headers (CLBLAST_CPPFLAGS) and the link flags
## (CLBLAST_LIBS). Enabling the backend with only one set would compile but
## fail to link, so gate COOT_USE_CLBLAST on having both -- same rule as the
## OpenCL check above.
if [ -n "${CLBLAST_CPPFLAGS}" ] && [ -n "${CLBLAST_LIBS}" ]; then
    echo "  CLBlast headers: found (via CLBLAST_CPPFLAGS)"
    echo "  CLBlast library: found (via CLBLAST_LIBS): ${CLBLAST_LIBS}"
    BANDICOOT_CXXFLAGS="${BANDICOOT_CXXFLAGS} -DCOOT_USE_CLBLAST ${CLBLAST_CPPFLAGS}"
    BANDICOOT_LIBS="${BANDICOOT_LIBS} ${CLBLAST_LIBS}"
    HAVE_CLBLAST=1
else
    echo "  CLBlast: not configured (need both CLBLAST_CPPFLAGS and CLBLAST_LIBS)"
    [ -z "${CLBLAST_CPPFLAGS}" ] && echo "    missing CLBLAST_CPPFLAGS"
    [ -z "${CLBLAST_LIBS}" ] && echo "    missing CLBLAST_LIBS"
    BANDICOOT_CXXFLAGS="${BANDICOOT_CXXFLAGS} -DCOOT_DONT_USE_CLBLAST"
    HAVE_CLBLAST=0
fi

## Always disable clBLAS (CLBlast is preferred)
BANDICOOT_CXXFLAGS="${BANDICOOT_CXXFLAGS} -DCOOT_DONT_USE_CLBLAS"
HAVE_CLBLAS=0

## Add common flags
BANDICOOT_CXXFLAGS="${OPENMP_CXXFLAGS} ${BANDICOOT_CXXFLAGS}"

## Add R's LAPACK/BLAS, resolved to real flags rather than left as make variable
## references -- exactly as configure.ac does on Unix.  R/flags.R is R source,
## not a makefile, so a literal $(LAPACK_LIBS) reaching RcppBandicootLdFlags()
## survives into a downstream package's PKG_LIBS via $(shell ...), which make
## does NOT re-expand; the recipe shell then treats it as command substitution
## and silently drops it, so the downstream package fails to link R's LAPACK.
LAPACK_LIBS=$("${R_HOME}/bin/R" CMD config LAPACK_LIBS)
BLAS_LIBS=$("${R_HOME}/bin/R" CMD config BLAS_LIBS)
FLIBS=$("${R_HOME}/bin/R" CMD config FLIBS)
LAPACK_BLAS_LIBS="${LAPACK_LIBS} ${BLAS_LIBS} ${FLIBS}"
BANDICOOT_LIBS="${BANDICOOT_LIBS} ${LAPACK_BLAS_LIBS}"

## Check if we have at least OpenCL.  Stopping here is deliberate, and matches
## the AC_MSG_ERROR configure.ac raises for the same condition: bandicoot's
## config.hpp self-defines COOT_USE_OPENCL when nothing disables it, so a build
## that continues past this point fails much later as an unreadable cascade of
## compiler errors about a missing <CL/opencl.h> rather than the actionable
## message below.
if [ "${HAVE_OPENCL}" = "0" ]; then
    echo ""
    echo "ERROR: No GPU backend detected!"
    echo ""
    echo "RcppBandicoot requires OpenCL headers to compile on Windows."
    echo "Set the following environment variables before building:"
    echo ""
    echo "  OPENCL_CPPFLAGS  - Path to OpenCL headers (e.g., -IC:/OpenCL/include)"
    echo "  OPENCL_LIBS      - OpenCL library flags (e.g., -LC:/OpenCL/lib -lOpenCL)"
    echo "  CLBLAST_CPPFLAGS - Path to CLBlast headers (optional)"
    echo "  CLBLAST_LIBS     - CLBlast library flags (optional)"
    echo ""
    exit 1
fi

echo ""
echo "Configuration Summary:"
echo "  OpenCL:  ${HAVE_OPENCL}"
echo "  CLBlast: ${HAVE_CLBLAST}"
echo "  CUDA:    disabled (Windows)"
echo "  Kernels: ${BANDICOOT_KERNELS_DIR}"
echo ""

## Generate Makevars.win from template
if [ -f "src/Makevars.win.in" ]; then
    sed -e "s|@BANDICOOT_CXXFLAGS@|$(esc "${BANDICOOT_CXXFLAGS}")|g" \
        -e "s|@BANDICOOT_LIBS@|$(esc "${BANDICOOT_LIBS}")|g" \
        -e "s|@OPENMP_CXXFLAGS@|$(esc "${OPENMP_CXXFLAGS}")|g" \
        -e "s|@OPENCL_TARGET_VERSION@|$(esc "${OPENCL_TARGET_VERSION}")|g" \
        -e "s|@BANDICOOT_KERNELS_DIR@|$(esc "${BANDICOOT_KERNELS_DIR}")|g" \
        src/Makevars.win.in > src/Makevars.win
    echo "Generated src/Makevars.win"
else
    echo "ERROR: src/Makevars.win.in not found!"
    exit 1
fi

## Verify the generated file
if [ -f "src/Makevars.win" ]; then
    echo "Contents of src/Makevars.win:"
    cat src/Makevars.win
else
    echo "ERROR: Failed to generate src/Makevars.win!"
    exit 1
fi

## Generate R/flags.R from template
## Set variables for flags.R.in substitution
HAVE_CUDA=0
HAVE_OPENMP=1
DEFAULT_BACKEND="CL_BACKEND"
OPENCL_CXXFLAGS_FOR_R=""
OPENCL_LIBS_FOR_R=""
CUDA_CXXFLAGS=""
CUDA_LIBS=""
CLBLAST_CXXFLAGS_FOR_R=""
CLBLAST_LIBS_FOR_R=""
CLBLAS_CXXFLAGS=""
CLBLAS_LIBS=""
## LAPACK_BLAS_LIBS is already resolved above, alongside BANDICOOT_LIBS; it must
## not be reset to make variable references here, since this block feeds R source.
CLBLAST_PREFIX=""
CLBLAS_PREFIX=""
CUDA_HOME=""
SDKPATH=""

## Set OpenCL flags for R if detected
if [ "${HAVE_OPENCL}" = "1" ]; then
    OPENCL_CXXFLAGS_FOR_R="-DCOOT_USE_OPENCL ${OPENCL_CPPFLAGS}"
    OPENCL_LIBS_FOR_R="${OPENCL_LIBS}"
fi

## Set CLBlast flags for R if detected
if [ "${HAVE_CLBLAST}" = "1" ]; then
    CLBLAST_CXXFLAGS_FOR_R="-DCOOT_USE_CLBLAST ${CLBLAST_CPPFLAGS}"
    CLBLAST_LIBS_FOR_R="${CLBLAST_LIBS}"
fi

if [ -f "R/flags.R.in" ]; then
    sed -e "s|@BANDICOOT_CXXFLAGS@|$(esc_r "${BANDICOOT_CXXFLAGS}")|g" \
        -e "s|@BANDICOOT_LIBS@|$(esc_r "${BANDICOOT_LIBS}")|g" \
        -e "s|@OPENCL_TARGET_VERSION@|$(esc_r "${OPENCL_TARGET_VERSION}")|g" \
        -e "s|@OPENCL_CXXFLAGS@|$(esc_r "${OPENCL_CXXFLAGS_FOR_R}")|g" \
        -e "s|@OPENCL_LIBS@|$(esc_r "${OPENCL_LIBS_FOR_R}")|g" \
        -e "s|@CUDA_CXXFLAGS@|$(esc_r "${CUDA_CXXFLAGS}")|g" \
        -e "s|@CUDA_LIBS@|$(esc_r "${CUDA_LIBS}")|g" \
        -e "s|@CLBLAST_CXXFLAGS@|$(esc_r "${CLBLAST_CXXFLAGS_FOR_R}")|g" \
        -e "s|@CLBLAST_LIBS@|$(esc_r "${CLBLAST_LIBS_FOR_R}")|g" \
        -e "s|@CLBLAS_CXXFLAGS@|$(esc_r "${CLBLAS_CXXFLAGS}")|g" \
        -e "s|@CLBLAS_LIBS@|$(esc_r "${CLBLAS_LIBS}")|g" \
        -e "s|@LAPACK_BLAS_LIBS@|$(esc_r "${LAPACK_BLAS_LIBS}")|g" \
        -e "s|@HAVE_OPENCL@|$(esc_r "${HAVE_OPENCL}")|g" \
        -e "s|@HAVE_CUDA@|$(esc_r "${HAVE_CUDA}")|g" \
        -e "s|@HAVE_CLBLAST@|$(esc_r "${HAVE_CLBLAST}")|g" \
        -e "s|@HAVE_CLBLAS@|$(esc_r "${HAVE_CLBLAS}")|g" \
        -e "s|@HAVE_OPENMP@|$(esc_r "${HAVE_OPENMP}")|g" \
        -e "s|@DEFAULT_BACKEND@|$(esc_r "${DEFAULT_BACKEND}")|g" \
        -e "s|@CLBLAST_PREFIX@|$(esc_r "${CLBLAST_PREFIX}")|g" \
        -e "s|@CLBLAS_PREFIX@|$(esc_r "${CLBLAS_PREFIX}")|g" \
        -e "s|@CUDA_HOME@|$(esc_r "${CUDA_HOME}")|g" \
        -e "s|@SDKPATH@|$(esc_r "${SDKPATH}")|g" \
        R/flags.R.in > R/flags.R
    echo "Generated R/flags.R"
else
    echo "ERROR: R/flags.R.in not found!"
    exit 1
fi
